# Copy this file to `.env` at the repository root and update the values
# before running `make render` or `make deploy`.

# Domain name that should receive the TLS certificate
DOMAIN=trojan.example.com

# Email address used for Let's Encrypt certificate registration
EMAIL=you@example.com

# Strong password that clients will use to authenticate with Trojan-Go
TROJAN_PASSWORD=please-change-me

# Optional: Path segment used for the Trojan-Go WebSocket endpoint.
# Must start with a leading slash.
WEBSOCKET_PATH=/trojan

# Internal port Trojan-Go listens on inside the Docker network
TROJAN_PORT=8443

# Optional timezone setting applied to containers that respect TZ
TZ=UTC

# Watchtower polling interval in seconds (only relevant when watchtower profile is enabled)
WATCHTOWER_INTERVAL=300

# Dynamic DNS settings for Namecheap (used by docker/scripts/update_dns.py)
# Host portion of the record. Use "@" for the root domain.
DNS_HOST=trojan
# Registered domain managed by Namecheap.
DNS_DOMAIN=example.com
# Namecheap Dynamic DNS password generated in the dashboard.
NAMECHEAP_DDNS_PASSWORD=change-me
